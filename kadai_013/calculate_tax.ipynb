      "source": [
        "def calculate_price(price, tax_rate):\n",
        "    #税込価格を計算する\n",
        "    #引数　price:商品の金額　tax_rate:税率（０以上の整数指定）\n",
        "    #戻り値：税込価格\n",
        "\n",
        "    return price * (1 + tax_rate / 100)\n",
        "\n",
        "result = calculate_price(110, 10)\n",
        "print(result)"
      ]
    }
  ]
