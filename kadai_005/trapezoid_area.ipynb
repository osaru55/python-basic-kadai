      "source": [
        "\"\"\"\n",
        "上辺：10cm\n",
        "下辺：20cm\n",
        "高さ：5cm\n",
        "\n",
        "公式：台形の面積 =（上辺＋下辺）× 高さ ÷ 2\n",
        "\"\"\"\n",
        "top_base = 10\n",
        "bottom_base = 20\n",
        "height = 5\n",
        "\n",
        "trapezoid_area = ( top_base + bottom_base ) * height / 2\n",
        "\n",
        "# 面積を表示\n",
        "print(f\"{trapezoid_area}cm²\")"
      ]
